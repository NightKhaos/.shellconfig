# History configuration
#
# HISTSIZE and SAVEHIST scale independently, because they hit DIFFERENT
# compression vectors — split into two per-machine flags (both default off):
#
#   big_shell_buffer   -> HISTSIZE (in-memory history). Anonymous RAM pages, so
#                         under pressure they go to zram (~3-4x on text). Also
#                         gates tmux history-limit (see ~/.config/tmux/tmux.conf).
#   big_shell_savehist -> SAVEHIST (the on-disk ~/.zsh_history file). A disk
#                         vector — filesystem compression / raw disk space, NOT
#                         zram. Kept separate so a zram box can hold a big
#                         in-RAM buffer without also bloating the on-disk file
#                         (or vice versa).
#
# Set in ~/.config/chezmoi/chezmoi.toml:
#     [data]
#       big_shell_buffer = true
#       big_shell_savehist = true
# Off (absent or false) -> 10000 each. On -> 250000.
{{ if and (hasKey . "big_shell_buffer") .big_shell_buffer }}HISTSIZE=250000{{ else }}HISTSIZE=10000{{ end }}
{{ if and (hasKey . "big_shell_savehist") .big_shell_savehist }}SAVEHIST=250000{{ else }}SAVEHIST=10000{{ end }}
HISTFILE=$HOME/.zsh_history
setopt appendhistory
# Write each command to $HISTFILE as it is entered, rather than batching the
# whole session's history into one append on shell exit. The batched-on-exit
# write is a large, infrequent fsync window; an unclean shutdown mid-flush
# leaves the un-flushed tail zero-filled by ext4 recovery (observed
# 2026-06-04: a 643-byte NUL run mid-file). Incremental append caps the loss
# at the single in-flight command. See specs/future-features.md "atuin".
setopt INC_APPEND_HISTORY
# Lock $HISTFILE with fcntl() during read/write so concurrent shells cannot
# interleave writes and corrupt the file. Also faster than zsh's default
# ad-hoc locking on modern Linux.
setopt HIST_FCNTL_LOCK
setopt HIST_IGNORE_SPACE
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
